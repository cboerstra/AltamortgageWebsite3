# --------------------------------------------------------------------------
# AGGRESSIVE BYPASS FOR /_next/static/ PATHS
# These contain randomly-named chunk files that ModSecurity sometimes
# misreads as suspicious. Disable all security/cache layers for them.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Disable ModSecurity entirely for Next.js static assets
    <IfModule mod_security2.c>
        SecRuleEngine Off
    </IfModule>
</IfModule>

<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>

# Try to disable ModSecurity per-location for static chunks
<LocationMatch "/_next/static/">
    <IfModule mod_security2.c>
        SecRuleEngine Off
    </IfModule>
</LocationMatch>

<FilesMatch "\.(css|js|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    <IfModule mod_security2.c>
        SecRuleEngine Off
    </IfModule>
</FilesMatch>

# --------------------------------------------------------------------------
# DISABLE LITESPEED CACHE FOR THIS APP.
# Hostinger uses LiteSpeed which aggressively caches responses, INCLUDING
# 503 errors during deploys.
# --------------------------------------------------------------------------
<IfModule LiteSpeed>
    CacheDisable public /
    RewriteEngine On
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# Belt-and-suspenders: tell ANY caching layer to revalidate static chunks.
<IfModule mod_headers.c>
    <FilesMatch "^_next/static/chunks/.+">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Larger request bodies (mortgage application can be >100KB of form data).
# --------------------------------------------------------------------------
<IfModule mod_reqtimeout.c>
    RequestReadTimeout header=20-40,MinRate=500 body=20,MinRate=500
</IfModule>

# --------------------------------------------------------------------------
# Compression — reduces over-the-wire response size.
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# --------------------------------------------------------------------------
# Force HTTPS (uncomment after SSL is installed and verified)
# --------------------------------------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
