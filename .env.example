# Public site URL (used by metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://altamortgagegroup.net

# Google Analytics / Tag Manager (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ---------------------------------------------------------------------------
# MISMO document storage  (REQUIRED for /apply)
#
# Every submitted application is written as a MISMO v3.4 (ULAD/URLA) XML file
# before anything else happens. This directory MUST NOT sit under public_html
# or any web-served path — it holds mortgage applications.
#
# Defaults to ../storage/mismo relative to the app directory, which on cPanel
# is a sibling of the Node app and is not web-served. Set it explicitly if your
# layout differs.
# ---------------------------------------------------------------------------
# MISMO_STORAGE_DIR=/home/USER/storage/mismo

# ---------------------------------------------------------------------------
# Database  (STRONGLY RECOMMENDED)
#
# Persists leads and applications and records the delivery status of each.
# Without it, the MISMO file on disk is the only copy of an application and
# nothing can be looked up by reference number.
#
# Run db/schema.sql once, then everything in db/migrations/.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# ---------------------------------------------------------------------------
# Email notifications  (RECOMMENDED)
#
# Sends the loan officer a summary of each application with the MISMO document
# attached. NOTHING in this system emails the applicant — not the website, not
# the CRM. Do not promise applicants a confirmation email.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.your-host.com
SMTP_PORT=587
SMTP_USER=notifications@altamortgagegroup.net
SMTP_PASS=your-smtp-password
NOTIFICATION_EMAIL=loans@altamortgagegroup.net

# ---------------------------------------------------------------------------
# CRM integration  (OPTIONAL, best effort)
#
# Leads and applications are forwarded to the Alta CRM's /api/website-lead
# endpoint, which creates the lead, logs an activity note, notifies the owner
# and texts the admins.
#
# This forward is best effort: three attempts, then given up on. It is NOT a
# system of record — the disk and the database above are. Leaving these unset
# degrades to "no CRM"; it does not stop applications from being stored.
#
# CRM_API_KEY must MATCH the WEBSITE_API_KEY environment variable on the CRM.
# ---------------------------------------------------------------------------
CRM_API_URL=https://altamortgagecrm.net/api/website-lead
CRM_API_KEY=your-shared-secret-matching-WEBSITE_API_KEY-on-the-crm
